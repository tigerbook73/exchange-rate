{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker/index.ts",
  "name": "icbc-rate",
  "account_id": "efda20f0c218e9d7193bcd2b228c35de",
  "workers_dev": true,
  "routes": [{ "pattern": "icbc-rate.tigerbook.top", "custom_domain": true }],
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "icbc-rate",
      "database_id": "d6a2a857-d667-4344-a049-ee4457ddb4ee",
      "preview_database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "observability": { "enabled": true, "traces": { "enabled": true } },
}
