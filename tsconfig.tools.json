{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "vitest.setup.ts",
    "cloudflare-env.d.ts",
    "src/lib/**/*.test.ts"
  ]
}
