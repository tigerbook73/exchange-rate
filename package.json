{
  "name": "icbc-rate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-service-worker.mjs",
    "start": "vite preview",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && tsc --noEmit -p src/sw/tsconfig.json && tsc --noEmit -p collector/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm run format:check && pnpm run lint && pnpm typecheck && pnpm run test && pnpm run test:e2e",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && pnpm run db:migrate:remote && pnpm run db:bootstrap:remote && node scripts/deploy-collector.mjs && wrangler deploy",
    "upload": "pnpm build && wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && wrangler types --config collector/wrangler.jsonc --env-interface CollectorEnv collector/worker-configuration.d.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:demo": "node scripts/local-data.mjs demo",
    "db:collect": "node scripts/local-data.mjs collect",
    "db:backfill": "node scripts/local-data.mjs backfill",
    "db:repair-gaps": "node scripts/local-data.mjs repair-gaps",
    "db:repair-gaps:remote": "node scripts/production-data.mjs repair-gaps --remote",
    "db:reset": "node scripts/local-data.mjs reset",
    "db:check": "node scripts/local-data.mjs check",
    "db:check:remote": "node scripts/production-data.mjs check --remote",
    "db:bootstrap:remote": "node scripts/production-data.mjs bootstrap --remote",
    "collector:dev": "wrangler dev --config collector/wrangler.jsonc --persist-to .wrangler/state --test-scheduled --port 8787",
    "collector:local": "node scripts/local-data.mjs watch",
    "deploy:collector": "pnpm run db:migrate:remote && pnpm run db:bootstrap:remote && node scripts/deploy-collector.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "htmlparser2": "^12.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.26.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "serwist": "^9.5.15",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@serwist/vite": "^9.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.10",
    "wrangler": "^4.166.0"
  },
  "type": "module"
}
