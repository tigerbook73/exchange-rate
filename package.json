{
  "name": "icbc-rate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/check-service-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/app/sw/tsconfig.json && tsc --noEmit -p collector/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm run format:check && pnpm run lint && pnpm typecheck && pnpm run test && pnpm run test:e2e",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && pnpm run db:migrate:remote && pnpm run db:bootstrap:remote && node scripts/deploy-collector.mjs && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && wrangler types --config collector/wrangler.jsonc --env-interface CollectorEnv collector/worker-configuration.d.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:demo": "node scripts/local-data.mjs demo",
    "db:collect": "node scripts/local-data.mjs collect",
    "db:backfill": "node scripts/local-data.mjs backfill",
    "db:reset": "node scripts/local-data.mjs reset",
    "db:check": "node scripts/local-data.mjs check",
    "db:check:remote": "node scripts/production-data.mjs check --remote",
    "db:bootstrap:remote": "node scripts/production-data.mjs bootstrap --remote",
    "collector:dev": "wrangler dev --config collector/wrangler.jsonc --persist-to .wrangler/state --test-scheduled --port 8787",
    "collector:local": "node scripts/local-data.mjs watch",
    "deploy:collector": "pnpm run db:migrate:remote && pnpm run db:bootstrap:remote && node scripts/deploy-collector.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@serwist/next": "^9.5.12",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "htmlparser2": "^12.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "serwist": "^9.5.12",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
